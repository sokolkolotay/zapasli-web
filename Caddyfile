{
	admin off
	persist_config off
	auto_https off
	servers {
		protocols h1
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@staticAssets path_regexp assets \.(?:svg|webp|png|jpg|jpeg|woff2)$
	header @staticAssets Cache-Control "public, max-age=604800"

	@revalidate path / /index.html /styles.css /app.js
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	file_server

	log {
		output stdout
		format json
	}
}
